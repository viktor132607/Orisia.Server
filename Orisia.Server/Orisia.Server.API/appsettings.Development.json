    "ThumbnailMaxWidth": 640,
    "ThumbnailMaxHeight": 640
  },
  "DevelopmentSettings": {
    "ResetDatabaseOnStart": false,
    "ExposeEmailPreviewLinks": true
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
