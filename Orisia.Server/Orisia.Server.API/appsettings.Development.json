{
  "ConnectionStrings": {
    "DefaultConnection": "Host=localhost;Port=5432;Database=orisiadb;Username=postgres;Password=postgres;"
  },
  "ClientApp": {
    "BaseUrl": "http://localhost:3000"
  },
  "Cors": {
    "AllowedOrigins": [
      "http://localhost:5173",
      "https://localhost:5173",
      "http://127.0.0.1:5173",
      "http://localhost:3000",
      "https://localhost:3000",
      "http://127.0.0.1:3000",
      "http://192.168.1.2:3000",
      "http://0.0.0.0:3000"
    ]
  },
  "Email": {
    "DeliveryMode": "Console",
    "SenderEmail": "dev-mail@orisia.local",
    "SenderName": "Orisia Dev",
    "PasswordResetTokenExpiryMinutes": 45
  },
  "MediaStorage": {
    "RootPath": "wwwroot/uploads/media",
