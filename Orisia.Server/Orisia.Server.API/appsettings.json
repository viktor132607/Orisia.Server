{
  "ConnectionStrings": {
    "DefaultConnection": "Host=localhost;Port=5432;Database=orisiadb;Username=postgres;Password=postgres;"
  },
  "Jwt": {
    "Issuer": "Orisia.Server.API",
    "Audience": "Orisia.Server.API.Client",
    "Secret": "ReplaceThisDevelopmentJwtSecretWithARealProductionSecret1234567890",
    "AccessTokenExpiryMinutes": 120,
    "RefreshTokenExpiryDays": 30
  },
  "ClientApp": {
    "BaseUrl": "http://localhost:3000"
  },
  "Cors": {
    "AllowedOrigins": [
      "http://localhost:5173",
      "https://localhost:5173",
      "https://orisia-client.onrender.com",
      "http://localhost:3000",
      "https://localhost:3000",
      "http://127.0.0.1:3000"
    ]
  },
  "Email": {
    "DeliveryMode": "Console",
    "SenderEmail": "noreply@orisia.local",
    "SenderName": "Orisia",
    "PasswordResetTokenExpiryMinutes": 30
  },
  "Payments": {
    "OnlineProviderName": "DemoSportPay",
    "OnlinePaymentLabel": "Online card payment",
    "SupportedMethods": [
      "online-card",
      "bank-transfer"
    ],
    "BankTransfer": {
      "Beneficiary": "Orisia Ltd.",
      "Iban": "BG00DEMO12345678901234",
      "Bic": "DEMOBGSF",
      "BankName": "Demo Bank",
      "ReferencePrefix": "SPORT"
    }
  },
  "Inventory": {
    "LowStockThreshold": 10
  },
  "DevelopmentSettings": {
    "ResetDatabaseOnStart": false,
    "ExposeEmailPreviewLinks": true
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}